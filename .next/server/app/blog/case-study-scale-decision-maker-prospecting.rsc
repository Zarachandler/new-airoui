26:["$","p",null,{"children":"Manual management works at low volume. Once account count grows past what a rep can track without a system, volume only scales by adding warmed inboxes and stronger process, not more hours."}]
27:["$","section",null,{"id":"time-spent","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Time spent on initial 10 accounts"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Manual lead research consumes a large share of each rep's week, covering LinkedIn searches, email verification, CRM entry, and sequence setup. Every hour spent on research is an hour not spent on live conversations."}]}]]}]
28:["$","section",null,{"id":"bad-data","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Inaccurate contact information"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Unverified contact lists damage sender reputation through bounces. At scale, that damage is cumulative, and recovery takes weeks once a domain earns poor standing with inbox providers."}]}]]}]
29:["$","section",null,{"id":"workflow-bottlenecks","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Rep workflow bottlenecks"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Context switching between a lead database, a sequencing tool, and a CRM fragments rep focus. A unified workflow changes the output equation by reducing wasted motion before a single email goes out."}]}]]}]
2a:["$","section",null,{"id":"limitations","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Limitations of initial prospecting strategies"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Manual prospecting works until volume breaks it. The limitations below compound as account count climbs and point to the same fix: infrastructure that scales independently of headcount."}]}]]}]
2b:["$","section",null,{"id":"meeting-targets","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Achieving monthly meeting targets"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"At 2-4 qualified meetings per rep per month, a team of five books roughly 10-20 meetings. If the target is 30-50 SQLs per quarter, manual methods put the team structurally behind from day one."}]}]]}]
2c:["$","section",null,{"id":"coverage-gaps","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Uncovering coverage gaps"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Most reps reach one or two stakeholders because database tools return contacts by title filter. That misses operational leaders, technical evaluators, and finance stakeholders who influence the final decision."}]}]]}]
2d:["$","section",null,{"id":"throughput","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Initial rep throughput challenges"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"Per-seat software models can penalize scale. Adding another rep may add cost, onboarding delay, and another period where the team is not yet productive."}]}]]}]
2e:["$","section",null,{"id":"strategy","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Strategy: new tools and optimized workflows"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":["$","p",null,{"children":"New tools alone will not fix broken workflows. The shift from manual to scaled prospecting requires the right infrastructure and the processes to run it consistently."}]}]]}]
2f:["$","section",null,{"id":"tech-stack","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Optimizing your prospecting tech stack"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Data layer:"}]," verified contact data at volume so reps start with clean contacts instead of raw exports."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sending layer:"}]," warmed email accounts with clear sending limits to distribute volume and protect domain reputation."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reply layer:"}]," centralized reply triage so no qualified response gets missed."]}]]}]}]]}]
30:["$","section",null,{"id":"flows","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Crafting repeatable prospecting flows"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Repeatable flows beat individual rep creativity at scale. The strongest sequences use one specific pain point, one proof point, and one low-friction ask."}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":"Multi-thread outreach across 3-5 stakeholders per account."}],["$","li",null,{"children":"Signal-based targeting from hiring, funding, or tech-stack changes."}],["$","li",null,{"children":"Subject line and opening line tests before scaling."}],["$","li",null,{"children":"Secondary sending domains to protect the primary brand domain."}],["$","li",null,{"children":"Automated follow-up sequences so interest is not lost after the first touch."}]]}]]}]]}]
31:["$","section",null,{"id":"deliverability","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Preventing email deliverability drops"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Scaling outreach volume without scaling warmup infrastructure causes deliverability to drop fast. Lost leads, damaged reputation, and spam placement can erase the gains from better copy."}],["$","p",null,{"children":"The practical fix is disciplined sending: cap each inbox, add warmed inboxes to increase total volume, keep warmup running, authenticate every domain, and verify every contact before launch."}]]}]]}]
32:["$","section",null,{"id":"playbooks","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Ensuring consistent prospecting playbooks"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Consistency breaks down when reps improvise at scale. Playbooks get adopted when they reduce decision fatigue: pre-approved subject lines, message templates by persona, objection handling scripts, and clear quality checks."}],["$","section",null,{"id":"ramp","className":"mt-7 scroll-mt-8","children":[["$","h3",null,{"className":"text-base font-bold leading-tight text-black","children":"Reducing rep ramp time to productivity"}],["$","div",null,{"className":"mt-3 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"A structured ramp protects inbox placement and shortens time to first meeting. Week one is infrastructure, weeks two and three are phased test sequences, and week four moves toward scaled production output."}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":"Week 1: authenticate domains, connect inboxes, activate warmup."}],["$","li",null,{"children":"Weeks 2-3: launch small tests and monitor placement daily."}],["$","li",null,{"children":"Week 4: increase volume while keeping bounce and placement thresholds tight."}]]}]]}]]}]]}]]}]
33:["$","section",null,{"id":"optimize","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Optimizing outreach for 100+ accounts"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"At 100+ accounts, volume is no longer the only constraint. The bottleneck shifts to conversion efficiency, clean handoffs between SDRs and AEs, and transparent cost-per-meeting economics."}],["$","div",null,{"className":"overflow-hidden rounded-lg border border-[#e5e7eb]","children":["$","table",null,{"className":"w-full text-left text-[12px]","children":[["$","thead",null,{"className":"bg-[#f8fafc] text-black","children":["$","tr",null,{"children":[["$","th",null,{"className":"px-4 py-3 font-bold","children":"Metric"}],["$","th",null,{"className":"px-4 py-3 font-bold","children":"Headcount scaling"}],["$","th",null,{"className":"px-4 py-3 font-bold","children":"Infrastructure scaling"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#e5e7eb]","children":[["$","tr","Annual tool cost",{"children":[["$","td","Annual tool cost",{"className":"px-4 py-3 text-black","children":"Annual tool cost"}],["$","td","Compounds by seat",{"className":"px-4 py-3 text-black","children":"Compounds by seat"}],["$","td","Predictable system cost",{"className":"px-4 py-3 text-black","children":"Predictable system cost"}]]}],["$","tr","Meetings booked",{"children":[["$","td","Meetings booked",{"className":"px-4 py-3 text-black","children":"Meetings booked"}],["$","td","Limited by manual throughput",{"className":"px-4 py-3 text-black","children":"Limited by manual throughput"}],["$","td","Grows with warmed capacity",{"className":"px-4 py-3 text-black","children":"Grows with warmed capacity"}]]}],["$","tr","Cost per meeting",{"children":[["$","td","Cost per meeting",{"className":"px-4 py-3 text-black","children":"Cost per meeting"}],["$","td","Often rises with headcount",{"className":"px-4 py-3 text-black","children":"Often rises with headcount"}],["$","td","Falls as workflow repeats",{"className":"px-4 py-3 text-black","children":"Falls as workflow repeats"}]]}]]}]]}]}]]}]]}]
34:["$","section",null,{"id":"learnings","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Key learnings for future prospecting"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Teams that sustain 100+ account programs verify every contact, optimize send timing, and invest in enablement before reps send at scale. These habits separate programs that grow pipeline consistently from those that stall after launch."}],["$","h3",null,{"className":"mt-6 text-base font-bold text-black","children":"Pre-launch prospecting checklist"}],["$","ul",null,{"className":"mt-3 list-disc space-y-2 pl-5 text-[13px] leading-7 text-black","children":[["$","li","Secondary domains registered and verified with SPF, DKIM, and DMARC",{"children":"Secondary domains registered and verified with SPF, DKIM, and DMARC"}],["$","li","2-5 inboxes connected per domain with warmup active",{"children":"2-5 inboxes connected per domain with warmup active"}],["$","li","Inbox placement test passed before first campaign launch",{"children":"Inbox placement test passed before first campaign launch"}],["$","li","Contacts verified and bounce rate target set below 2%",{"children":"Contacts verified and bounce rate target set below 2%"}],["$","li","Sequence templates approved by the team lead",{"children":"Sequence templates approved by the team lead"}],["$","li","A/B test variants prepared for subject lines and opening lines",{"children":"A/B test variants prepared for subject lines and opening lines"}],["$","li","Reply inbox configured for centralized management",{"children":"Reply inbox configured for centralized management"}],["$","li","CRM integration connected and tested with a dummy lead",{"children":"CRM integration connected and tested with a dummy lead"}],["$","li","Send cap set at 30 per inbox per day",{"children":"Send cap set at 30 per inbox per day"}],["$","li","Placement test schedule configured",{"children":"Placement test schedule configured"}]]}]]}]]}]
35:["$","section",null,{"id":"faqs","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"FAQs"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","div","How long does it take to scale from 10 to 100+ accounts?",{"className":"mt-6","children":[["$","h3",null,{"className":"text-base font-bold text-black","children":"How long does it take to scale from 10 to 100+ accounts?"}],["$","p",null,{"className":"mt-3 text-[13px] leading-7 text-black","children":"Plan for at least four weeks before full-volume sending on new domains. Week one is authentication and warmup, weeks two and three are phased tests, and week four is where volume can increase while performance is monitored closely."}]]}],["$","div","What tools do sales leaders need to scale decision maker outreach?",{"className":"mt-6","children":[["$","h3",null,{"className":"text-base font-bold text-black","children":"What tools do sales leaders need to scale decision maker outreach?"}],["$","p",null,{"className":"mt-3 text-[13px] leading-7 text-black","children":"The core stack is verified lead data, a multi-inbox sending system with warmup, and a unified reply inbox. The goal is to keep list quality, sending health, and reply routing inside one repeatable workflow."}]]}],["$","div","How do you ensure consistent primary inbox placement at scale?",{"className":"mt-6","children":[["$","h3",null,{"className":"text-base font-bold text-black","children":"How do you ensure consistent primary inbox placement at scale?"}],["$","p",null,{"className":"mt-3 text-[13px] leading-7 text-black","children":"Authenticate every domain, keep warmup running, cap sends per inbox, verify contacts before upload, and run inbox placement tests weekly. If spam placement rises, reduce volume and clean the list before resuming."}]]}],["$","div","What team structure works best for scaling decision maker prospecting?",{"className":"mt-6","children":[["$","h3",null,{"className":"text-base font-bold text-black","children":"What team structure works best for scaling decision maker prospecting?"}],["$","p",null,{"className":"mt-3 text-[13px] leading-7 text-black","children":"A small SDR team can cover far more accounts when each rep has warmed sending capacity, shared rules for deliverability, and a centralized process for routing positive replies."}]]}]]}]]}]
