18:["$","article",null,{"className":"min-w-0","children":[["$","p",null,{"className":"text-xs font-medium text-[#6b7280]","children":"Updated May 25, 2026"}],["$","h2",null,{"id":"overview","className":"mt-5 scroll-mt-8 text-xl font-bold leading-tight text-[#061534]","children":"Overview"}],["$","div",null,{"className":"mt-5 border-l-2 border-[#2f7df6] bg-[#f8fbff] px-5 py-4","children":[["$","p",null,{"className":"text-sm font-bold text-black","children":"TL;DR:"}],["$","p",null,{"className":"mt-3 text-[13px] leading-7 text-black","children":"Scaling decision maker prospecting past 10 accounts breaks manual workflows quickly. Teams that reach 100+ accounts without burning domains stop adding headcount as the only answer and start building infrastructure: warmed sending accounts, verified contact data, dedicated warmup, and centralized reply triage."}]]}],["$","p",null,{"className":"mt-6 text-[13px] leading-7 text-black","children":"Adding more SDRs is often the most expensive way to scale decision-maker prospecting. Domain health, list quality, and sending infrastructure determine success at scale far more than raw activity. The sections below break down the workflows, ramp plans, and deliverability systems that help sales leaders multiply pipeline without multiplying manual work."}],["$","section",null,{"id":"customer-story","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"Customer story: scaling outreach without adding headcount"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Before consolidating outreach into a multi-inbox workflow, reps were managing sends manually across separate tools with no centralized reply view. Ramp times were slow, follow-up was inconsistent, and leaders could not reliably see per-rep output."}],["$","blockquote",null,{"className":"border-l-2 border-[#061534] pl-4 text-[13px] italic leading-7 text-black","children":"\"Cold outreach becomes operationally simple at scale when campaign setup, warmup, sending limits, and reply management live in the same workflow.\""}],["$","p",null,{"children":"This pattern, operationally simple outreach at scale with inbox placement protected at higher volumes, is the model this playbook is built on."}]]}]]}],["$","section",null,{"id":"challenge","className":"mt-10 scroll-mt-8","children":[["$","h2",null,{"className":"text-xl font-bold leading-tight text-[#061534]","children":"The challenge: manual prospecting at 10 accounts"}],["$","div",null,{"className":"mt-4 space-y-4 text-[13px] leading-7 text-black","children":[["$","p",null,{"children":"Enterprise prospecting is structurally different from SMB prospecting. The same rep workflow that works at 10 accounts breaks down as account count grows."}],["$","div",null,{"className":"overflow-hidden rounded-lg border border-[#e5e7eb]","children":["$","table",null,{"className":"w-full text-left text-[12px]","children":[["$","thead",null,{"className":"bg-[#f8fafc] text-black","children":["$","tr",null,{"children":[["$","th",null,{"className":"px-4 py-3 font-bold","children":"Dimension"}],["$","th",null,{"className":"px-4 py-3 font-bold","children":"SMB prospecting"}],["$","th",null,{"className":"px-4 py-3 font-bold","children":"Enterprise prospecting"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#e5e7eb]","children":[["$","tr","Buying committee size",{"children":[["$","td","Buying committee size",{"className":"px-4 py-3 text-black","children":"Buying committee size"}],["$","td","2-4 stakeholders",{"className":"px-4 py-3 text-black","children":"2-4 stakeholders"}],["$","td","5-8 contacts across 3+ roles",{"className":"px-4 py-3 text-black","children":"5-8 contacts across 3+ roles"}]]}],"$L22","$L23","$L24","$L25"]}]]}]}],"$L26"]}]]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37"]}]
